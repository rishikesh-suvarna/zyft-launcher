<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Zyft Launcher</string>

    <color name="background">#FF0E0F12</color>
    <color name="tile">#B3262A33</color>
    <color name="text_primary">#FFF2F3F5</color>
    <color name="text_secondary">#FF9AA0AA</color>
    <color name="focus">#FFFFFFFF</color>
    <color name="moving">#FFFFB300</color>

    <dimen name="tile_width">168dp</dimen>
    <dimen name="tile_height">94dp</dimen>
    <dimen name="tile_gap">14dp</dimen>
    <dimen name="screen_padding_h">48dp</dimen>
    <dimen name="screen_padding_v">28dp</dimen>

    <!-- Solid window background so the first frame is drawn instantly, no wallpaper decode. -->
    <style name="LauncherTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
